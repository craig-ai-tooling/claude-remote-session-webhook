{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "labels": {
      "app.kubernetes.io/part-of": "crswd"
    },
    "name": "crswd-sessions",
    "namespace": "crswd-next"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "50Gi"
      }
    },
    "storageClassName": "linstor-replicated"
  }
}
