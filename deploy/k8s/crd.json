{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "agentsessions.crswd.craigcloud.io"
  },
  "spec": {
    "group": "crswd.craigcloud.io",
    "names": {
      "kind": "AgentSession",
      "listKind": "AgentSessionList",
      "plural": "agentsessions",
      "shortNames": [
        "as"
      ],
      "singular": "agentsession"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".spec.startCommand",
            "name": "Start",
            "type": "string"
          },
          {
            "jsonPath": ".status.phase",
            "name": "Phase",
            "type": "string"
          },
          {
            "jsonPath": ".metadata.creationTimestamp",
            "name": "Age",
            "type": "date"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "properties": {
              "spec": {
                "properties": {
                  "conversation": {
                    "type": "string"
                  },
                  "lifetime": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "sessionName": {
                    "type": "string"
                  },
                  "startCommand": {
                    "type": "string"
                  },
                  "workDir": {
                    "type": "string"
                  }
                },
                "required": [
                  "sessionName",
                  "owner",
                  "workDir",
                  "startCommand",
                  "lifetime"
                ],
                "type": "object",
                "x-kubernetes-validations": [
                  {
                    "message": "sessionName is immutable",
                    "rule": "self.sessionName == oldSelf.sessionName"
                  },
                  {
                    "message": "owner is immutable",
                    "rule": "self.owner == oldSelf.owner"
                  },
                  {
                    "message": "workDir is immutable",
                    "rule": "self.workDir == oldSelf.workDir"
                  },
                  {
                    "message": "startCommand is immutable",
                    "rule": "self.startCommand == oldSelf.startCommand"
                  },
                  {
                    "message": "lifetime is immutable",
                    "rule": "self.lifetime == oldSelf.lifetime"
                  }
                ]
              },
              "status": {
                "properties": {
                  "conversation": {
                    "type": "string"
                  },
                  "phase": {
                    "enum": [
                      "Pending",
                      "Running",
                      "Rejected",
                      "Reviving",
                      "Failed"
                    ],
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
