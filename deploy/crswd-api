#!/usr/bin/env bash
# crswd API client — works from macOS or Linux, called from any shell.
#
#   crswd-api GET    /sessions
#   crswd-api POST   /sessions '{"name":"demo","work_dir":"$HOME/code/x"}'
#   crswd-api POST   /sessions/<id>/prompt '{"text":"hi"}' <token>
#   crswd-api GET    /sessions/<id>/output '' <token>
#   crswd-api DELETE /sessions/<id>        '' <token>
#
# Four headers on every call. Two admit you at Cloudflare's edge; two prove the
# request to the daemon. The edge deciding you may knock never substitutes for
# the daemon deciding you may come in — drop the signature and you still get 401.
#
# A 401 is retried up to three times, each under a fresh timestamp. The
# signature has one-second resolution, so two callers making the same request in
# the same second are byte-identical and the daemon refuses the second as a
# replay — see the note above the retry at the foot of this file.
#
# Portability notes, each of which was a real hazard:
#   - The request path is `reqpath`, never `path`. In zsh `path` is tied to PATH,
#     so `local path=/sessions` silently sets PATH=/sessions and every external
#     command vanishes for the length of the call.
#   - PATH is only APPENDED to. Prepending would shadow Homebrew's tools with
#     /usr/bin versions on a Mac, which is the opposite of helpful.
#   - `date +%s` and `awk '{print $NF}'` behave the same under BSD and GNU, and
#     the hex digest is the last field for both OpenSSL and LibreSSL output.
#   - bash 3.2 compatible, which is what macOS ships as /bin/bash.
set -eu
export PATH="${PATH:-}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

usage() { sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1-}" in
  -h|--help) usage; exit 0 ;;
  "")        usage >&2; exit 2 ;;
esac

missing=""
for tool in op curl openssl awk date; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "crswd-api: not on PATH:$missing" >&2
  echo "  op is the 1Password CLI — brew install 1password-cli, then enable" >&2
  echo "  'Integrate with 1Password CLI' in the desktop app's Developer settings." >&2
  exit 1
fi

method="$1"
reqpath="${2:?usage: crswd-api METHOD PATH [BODY] [BEARER]}"
body="${3-}"
bearer="${4-}"
# Loopback by default, because that is where the daemon listens and it is the
# one address that is correct on every host. A published hostname is one
# operator's deployment, and shipping one as the default means every other
# operator's requests go somewhere they did not choose — silently, and with
# their signature attached.
host="${CRSWD_HOST:-http://127.0.0.1:8765}"
vault="${CRSWD_OP_ITEM:-op://Lobster/crswd}"

sec=$(op read "$vault/shared-secret") || { echo "crswd-api: could not read $vault/shared-secret" >&2; exit 1; }
cid=$(op read "$vault/access-client-id")
csec=$(op read "$vault/access-client-secret")
# Sign and send once. METHOD \n PATH \n timestamp . body — the request line is
# signed, so one signed read is not a valid destroy at the same instant. Leaves
# the response body in $out and the HTTP status in $status.
send() {
  ts=$(date +%s)
  sig=$(printf '%s\n%s\n%s.%s' "$method" "$reqpath" "$ts" "$body" \
        | openssl dgst -sha256 -hmac "$sec" | awk '{print $NF}')

  set -- -sS -w '\n%{http_code}' -X "$method" "$host$reqpath" \
    -H "CF-Access-Client-Id: $cid" \
    -H "CF-Access-Client-Secret: $csec" \
    -H "X-CRSW-Timestamp: $ts" \
    -H "X-CRSW-Signature: sha256=$sig"
  [ -n "$bearer" ] && set -- "$@" -H "Authorization: Bearer $bearer"
  [ -n "$body" ] && set -- "$@" -H "Content-Type: application/json" -d "$body"

  reply=$(curl "$@")
  status=${reply##*$'\n'}
  out=${reply%$'\n'*}
}

send

# The timestamp has one-second resolution and nothing else in the payload
# varies, so two callers making the same request in the same second send
# byte-identical signatures and the daemon's replay cache refuses the second
# one. It is right to refuse: it cannot tell an accidental collision from a
# captured request being replayed. The caller can — it has just issued this
# request for the first time — so it re-signs under a later timestamp and asks
# again.
#
# Measured on the host that runs a dozen of these: 128 refusals in the 14 days
# before 9/16/26, 9 a day. One retry was enough until 9/21/26 23:46Z, when it
# was not: the timers for deliver, repo-drift and retire-sessions fire in the
# same second, sessions were listed at :04 and again at :06, and
# retire-sessions lost its first attempt at :04 and its one retry at :06. It
# exited 2 and closed nothing. Three retries: a caller that keeps losing to a
# busy second gets more seconds to try in. A genuinely wrong secret still ends
# in the daemon's denial, after four requests over at most six seconds.
#
# The wait is randomised, so two callers that both lost to a third do not line
# up again. It is at least one second, so every retry is signed under a later
# timestamp than the attempt it replaces. Re-sending is safe whatever the
# method: the signature is checked before the handler runs, so a 401 executed
# nothing.
retries=0
while [ "$status" = "401" ] && [ "$retries" -lt 3 ]; do
  retries=$((retries + 1))
  sleep $((1 + RANDOM % 2))
  send
done

printf '%s\n' "$out"
